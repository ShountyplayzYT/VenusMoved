# Neon Postgres connection string (get from Neon dashboard).
# Use the "pooled" connection string for serverless.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign auth JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# OpenAI (used for Whisper transcription, lane parsing, and the pricing model)
OPENAI_API_KEY=sk-...

# Optional: powers live weather lookups in the AI pricing panel
OPENWEATHER_KEY=

# Optional fallback login (in addition to any accounts created via Sign Up)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=trucker2026

# Sent as the Nominatim User-Agent contact per their usage policy
NOMINATIM_CONTACT_EMAIL=you@example.com

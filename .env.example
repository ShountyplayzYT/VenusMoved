# Neon Postgres connection string (get from Neon dashboard).
# Use the "pooled" connection string for serverless.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign auth JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# OpenAI (used for Whisper transcription, lane parsing, and the pricing model)
OPENAI_API_KEY=sk-...

# Optional: powers live weather lookups in the AI pricing panel
OPENWEATHER_KEY=

# Optional fallback login (in addition to any accounts created via Sign Up)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=trucker2026

# Sent as the Nominatim User-Agent contact per their usage policy
NOMINATIM_CONTACT_EMAIL=you@example.com

# DAT Rateview (linehaul rates) API - used as a fallback lookup when a
# lane has no matching shipment history in our own database.
#
# DAT uses a two-step Access API auth flow instead of a single static
# token: our Service Account credentials get exchanged for an
# organization token, which is then exchanged for an individual token
# (valid ~30 min) that's actually used to call Rateview. See api/_lib/dat.py
# for details. Docs: https://developer.dat.com/developer-portal/authentication/access

# Service Account credentials (client-chosen username/password; for
# non-production these are provisioned by DAT Tech Support).
DAT_SERVICE_USERNAME=
DAT_SERVICE_PASSWORD=
# Individual DAT user login used to mint the per-user access token.
DAT_INDIVIDUAL_USERNAME=

# Optional: override the DAT identity/auth server (defaults to production).
# Staging: https://identity.api.staging.dat.com/access
DAT_IDENTITY_BASE_URL=https://identity.api.dat.com/access

# Optional: override the DAT Rateview server (defaults to production).
# Staging:  https://analytics.api.staging.dat.com/linehaulrates
# Nprod:    https://analytics.api.nprod.dat.com/linehaulrates
DAT_API_BASE_URL=https://analytics.api.dat.com/linehaulrates
# Optional: defaults used for the DAT fallback lookup.
DAT_DEFAULT_EQUIPMENT=VAN
DAT_DEFAULT_RATE_TYPE=CONTRACT